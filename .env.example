# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. This project makes no calls to any AI/LLM API,
# so there is no API_KEY here -- only the login-gate credentials.

APP_USERNAME=
APP_PASSWORD=

# Signs the login session cookie. Any long random string. If left blank,
# the app generates one at startup (fine for local dev; on a host with
# more than one worker process, set this explicitly so all workers share
# the same signing key).
SECRET_KEY=
